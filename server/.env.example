# Реальный секрет создаёт npm run setup в локальном server/.env.
SESSION_SECRET=
NODE_ENV=development
# В production обязательны HTTPS и Secure cookie.
# APP_ORIGINS=https://your-domain.example
# TRUST_PROXY=1
# Amvera: NODE_ENV=production, PORT=3001, DATABASE_PATH=/data/tochka.sqlite.
# AMVERA=1 задаётся платформой автоматически и также включает production и Secure cookie.
# Значения задаются в панели Amvera; локальный .env туда не загружается.
# В production сервер слушает 0.0.0.0, база по умолчанию — /data/tochka.sqlite.
# PORT=3001
# DATABASE_PATH=/data/tochka.sqlite
# Однократная демоинициализация при старте; по умолчанию отключена.
# DEMO_INIT_ENABLED=true
# Пароли задаются отдельными секретами Amvera (12–256 символов), без записи в код/логи.
# DEMO_STUDENT1_PASSWORD=
# DEMO_STUDENT2_PASSWORD=
# DEMO_STAFF_PASSWORD=
# После успешного запуска уберите флаг и три секрета, перезапустите приложение.
